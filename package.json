{
  "name": "bg-2-cellml",
  "description": "Generate CellML 2.0 from BG-RDF bond graph models, in TypeScript",
  "private": true,
  "license": "Apache-2.0",
  "author": {
    "name": "Hugh Sorby",
    "email": "h.sorby@auckland.ac.nz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/physiomelinks/celldl2cellml.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --noEmit",
    "test": "yarn workspaces foreach --all --topological --parallel run test",
    "reference": "uv run --project tools/reference python tools/reference/generate.py",
    "stats": "node tools/stats/build.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.12.0"
}
