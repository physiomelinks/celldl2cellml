{
  "name": "@physiomelinks/cellml-units",
  "description": "Turn UCUM unit codes into CellML 2.0 units, and compare and convert them with libCellML.",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/physiomelinks/bg-2-cellml.git",
    "directory": "packages/cellml-units"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
