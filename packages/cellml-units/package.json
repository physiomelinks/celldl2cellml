{
  "name": "@physiomelinks/cellml-units",
  "description": "Turn UCUM unit codes into CellML 2.0 units, and compare and convert them with libCellML.",
  "version": "0.5.0",
  "license": "Apache-2.0",
  "author": {
    "name": "Hugh Sorby",
    "email": "h.sorby@auckland.ac.nz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/physiomelinks/celldl2cellml.git",
    "directory": "packages/cellml-units"
  },
  "homepage": "https://github.com/physiomelinks/celldl2cellml/tree/main/packages/cellml-units#readme",
  "bugs": {
    "url": "https://github.com/physiomelinks/celldl2cellml/issues"
  },
  "keywords": [
    "cellml",
    "ucum",
    "units",
    "libcellml"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepack": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "libcellml.js": ">=0.7.1"
  },
  "devDependencies": {
    "libcellml.js": "^0.7.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
