{
  "name": "@physiomelinks/bg2cellml",
  "description": "Generate CellML 2.0 from BG-RDF bond graph models, in JavaScript.",
  "version": "0.6.2",
  "license": "Apache-2.0",
  "author": {
    "name": "David Brooks",
    "email": "d.brooks@auckland.ac.nz"
  },
  "contributors": [
    {
      "name": "Claude (Anthropic)",
      "url": "https://claude.ai",
      "role": "AI Assistant"
    },
    {
      "name": "Hugh Sorby",
      "email": "h.sorby@auckland.ac.nz"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/physiomelinks/celldl2cellml.git",
    "directory": "packages/bg2cellml"
  },
  "homepage": "https://github.com/physiomelinks/celldl2cellml/tree/main/packages/bg2cellml#readme",
  "bugs": {
    "url": "https://github.com/physiomelinks/celldl2cellml/issues"
  },
  "keywords": [
    "bond-graph",
    "bg-rdf",
    "cellml",
    "celldl",
    "physiome"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "prepack": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parity": "BG2CELLML_PARITY=all vitest run test/parity.test.ts"
  },
  "dependencies": {
    "@physiomelinks/cellml-units": "workspace:^",
    "@physiomelinks/math-ast": "workspace:^",
    "@xmldom/xmldom": "^0.9.8"
  },
  "peerDependencies": {
    "libcellml.js": ">=0.7.1",
    "oxigraph": ">=0.5.9 <0.6"
  },
  "devDependencies": {
    "@opencor/libopencor": "^1.20261016.1",
    "libcellml.js": "^0.7.1",
    "oxigraph": "^0.5.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
