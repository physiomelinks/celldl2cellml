@prefix bgf: <https://bg-rdf.org/ontologies/bondgraph-framework#> .
@prefix cdt: <https://w3id.org/cdt/> .
@prefix tpl: <https://bg-rdf.org/templates/> .

@prefix : <#> .

# S1 -> Rx R1 -> S2, as the CellDL Editor draws it: stores with zero nodes and
# a reaction. convert() should give v_q_S1_c = -v_Rx_R1_c and v_q_S2_c = v_Rx_R1_c.
# Simulate for 20 seconds at 0.01 second steps.

:model
    a bgf:BondgraphModel ;
    bgf:usesTemplate tpl:chemical.ttl ;
    bgf:hasBondElement :S1, :S2, :R1 .

:S1
    a bgf:ChemicalStorageNode ;
    bgf:hasSymbol "q" ; bgf:hasSpecies "S1" ; bgf:hasLocation "c" ;
    bgf:hasValue "2 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "1 mol-1"^^cdt:ucum ] .

:S2
    a bgf:ChemicalStorageNode ;
    bgf:hasSymbol "q" ; bgf:hasSpecies "S2" ; bgf:hasLocation "c" ;
    bgf:hasValue "0.1 mol"^^cdt:ucum ;
    bgf:parameterValue [ bgf:varName "K" ; bgf:hasValue "2 mol-1"^^cdt:ucum ] .

:R1
    a bgf:ChemicalReaction ;
    bgf:hasSymbol "Rx" ; bgf:hasSpecies "R1" ; bgf:hasLocation "c" ;
    bgf:parameterValue [ bgf:varName "kappa" ; bgf:hasValue "0.3 mol/s"^^cdt:ucum ] .

:S1.R1 bgf:hasSource :S1 ; bgf:hasTarget :R1 .
:R1.S2 bgf:hasSource :R1 ; bgf:hasTarget :S2 .
