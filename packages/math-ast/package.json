{
  "name": "@physiomelinks/math-ast",
  "description": "A small expression tree for Content MathML: read, build, compare, substitute, tidy and write equations.",
  "version": "0.6.1",
  "license": "Apache-2.0",
  "author": {
    "name": "Hugh Sorby",
    "email": "h.sorby@auckland.ac.nz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/physiomelinks/celldl2cellml.git",
    "directory": "packages/math-ast"
  },
  "homepage": "https://github.com/physiomelinks/celldl2cellml/tree/main/packages/math-ast#readme",
  "bugs": {
    "url": "https://github.com/physiomelinks/celldl2cellml/issues"
  },
  "keywords": [
    "mathml",
    "content-mathml",
    "expression",
    "ast",
    "cellml"
  ],
  "type": "module",
